{
  "name": "local-ai-memory-fabric",
  "version": "0.2.0",
  "private": true,
  "description": "Local-only shared persistent memory and safe tooling for local AI agents",
  "type": "module",
  "bin": {
    "local-memory": "dist/packages/cli/src/index.js"
  },
  "scripts": {
