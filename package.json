    "start:desktop": "electron ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "main": "desktop/main.js"
}
